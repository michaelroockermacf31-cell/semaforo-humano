<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Semáforo Humano</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f6f9;color:#333;max-width:600px;margin:0 auto;padding:20px}.header{background:#2c3e50;color:white;padding:20px;border-radius:10px 10px 0 0;text-align:center}.container{background:white;padding:25px;border-radius:0 0 10px 10px;box-shadow:0 4px 15px rgba(0,0,0,0.1)}.section{margin-bottom:25px;border-bottom:1px solid #eee;padding-bottom:15px}.section h3{color:#2980b9;margin-bottom:15px}.question{margin-bottom:15px}.question p{font-weight:600;margin-bottom:8px;font-size:0.95em}label{display:block;margin-bottom:6px;cursor:pointer;padding:8px;border-radius:5px}label:hover{background-color:#f0f8ff}input[type="radio"]{margin-right:10px}button{width:100%;padding:15px;background-color:#27ae60;color:white;border:none;border-radius:8px;font-size:1.1em;font-weight:bold;cursor:pointer}button:hover{background-color:#219150}#resultado{display:none;margin-top:25px;padding:20px;border-radius:8px;text-align:center}.verde{background-color:#d4edda;color:#155724;border:2px solid #c3e6cb}.amarillo{background-color:#fff3cd;color:#856404;border:2px solid #ffeeba}.rojo{background-color:#f8d7da;color:#721c24;border:2px solid #f5c6cb}#mensajeExpirado{display:none;text-align:center;padding:30px;background:#fff3cd;border:2px solid #ffeeba;border-radius:10px}#mensajeExpirado h2{color:#856404}.btn-whatsapp{display:inline-block;background-color:#25D366;color:white;padding:12px 25px;text-decoration:none;border-radius:8px;font-weight:bold;margin-top:10px}
</style>
</head>
<body>
<div class="header"><h2> SISTEMA SEMÁFORO HUMANO</h2><p>Evaluación Predictiva de Capacidad Operativa</p></div>
<div class="container">
<div id="mensajeExpirado"><h2>⏳ PERIODO DE PRUEBA FINALIZADO</h2><p>Los 7 días de prueba gratuita han concluido.</p><p>Para adquirir la licencia, contáctame:</p><a href="https://wa.me/56957577510" class="btn-whatsapp" target="_blank"> Contactar a Miguel Ángel</a></div>
<form id="evaluacionForm">
<div class="section"><h3>1. Fatiga y Sueño</h3>
<div class="question"><p>1. ¿Cuántas horas dormiste?</p>
<label><input type="radio" name="q1" value="0" required> 7+ horas</label>
<label><input type="radio" name="q1" value="2"> 5-6 horas</label>
<label><input type="radio" name="q1" value="3"> Menos de 5 horas</label></div>
<div class="question"><p>2. ¿Tu atención está lenta?</p>
<label><input type="radio" name="q2" value="0" required> No, estoy alerta</label>
<label><input type="radio" name="q2" value="2"> Un poco</label>
<label><input type="radio" name="q2" value="3"> Sí, mucho</label></div></div>
<div class="section"><h3>2. Salud Física</h3>
<div class="question"><p>3. ¿Sientes dolor muscular?</p>
<label><input type="radio" name="q3" value="0" required> No o leve</label>
<label><input type="radio" name="q3" value="2"> Sí, pero trabajo</label>
<label><input type="radio" name="q3" value="3"> Sí, severo</label></div>
<div class="question"><p>4. ¿Sientes mareos?</p>
<label><input type="radio" name="q4" value="0" required> No</label>
<label><input type="radio" name="q4" value="2"> Leve</label>
<label><input type="radio" name="q4" value="3"> Sí, notable</label></div></div>
<div class="section"><h3>3. Salud Mental</h3>
<div class="question"><p>5. ¿Preocupaciones te distraen?</p>
<label><input type="radio" name="q5" value="0" required> No</label>
<label><input type="radio" name="q5" value="2"> Algunas</label>
<label><input type="radio" name="q5" value="3"> Sí, muchas</label></div>
<div class="question"><p>6. ¿Te sientes irritable?</p>
<label><input type="radio" name="q6" value="0" required> No</label>
<label><input type="radio" name="q6" value="2"> Un poco</label>
<label><input type="radio" name="q6" value="3"> Sí, mucho</label></div></div>
<div class="section"><h3>4. Sustancias</h3>
<div class="question"><p>7. ¿Consumiste alcohol/sustancias (24h)?</p>
<label><input type="radio" name="q7" value="0" required> No</label>
<label><input type="radio" name="q7" value="3"> Sí</label></div>
<div class="question"><p>8. ¿Tomaste medicamentos?</p>
<label><input type="radio" name="q8" value="0" required> No</label>
<label><input type="radio" name="q8" value="2"> Sí, pero bien</label>
<label><input type="radio" name="q8" value="3"> Sí, aturdido</label></div></div>
<button type="button" onclick="calcularRiesgo()">EVALUAR CAPACIDAD OPERATIVA</button>
</form>
<div id="resultado"></div>
</div>
<script>
const DIAS_PRUEBA=7;const hoy=new Date();let fechaInicio=localStorage.getItem('semaforo_inicio_prueba');
if(!fechaInicio){localStorage.setItem('semaforo_inicio_prueba',hoy.toISOString());}
else{const inicio=new Date(fechaInicio);const diasTranscurridos=Math.ceil(Math.abs(hoy-inicio)/(1000*60*60*24));if(diasTranscurridos>DIAS_PRUEBA){document.getElementById('evaluacionForm').style.display='none';document.getElementById('mensajeExpirado').style.display='block';}}
function calcularRiesgo(){const form=document.getElementById('evaluacionForm');const formData=new FormData(form);let puntajeTotal=0;let preguntasRespondidas=0;
for(let value of formData.values()){puntajeTotal+=parseInt(value);preguntasRespondidas++;}
if(preguntasRespondidas<8){alert("Responde todas las preguntas.");return;}
const resultadoDiv=document.getElementById('resultado');let estado,clase,recomendacion;
if(puntajeTotal<=3){estado="🟢 VERDE: CAPACIDAD COMPLETA";clase="verde";recomendacion="Apto para todo tipo de trabajo.";}
else if(puntajeTotal<=7){estado="🟡 AMARILLO: OBSERVACIÓN";clase="amarillo";recomendacion="No operar maquinaria pesada ni trabajar en altura.";}
else{estado=" ROJO: NO APTO";clase="rojo";recomendacion="Derivar a evaluación. No ingresar a zona de obra.";}
resultadoDiv.className=clase;resultadoDiv.style.display="block";resultadoDiv.innerHTML=`<h2>${estado}</h2><p>${recomendacion}</p>`;}
</script>
</body>
</html>
